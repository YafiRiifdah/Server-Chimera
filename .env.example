# Chimera Server Configuration

# Port aplikasi
PORT=5100

# Root folder penyimpanan file pengguna
# Produksi (Linux): /mnt/data/Chimera
# Development (Windows/lokal): ./storage
STORAGE_ROOT=./storage

# Folder database metadata SQLite & cache internal
# Produksi (Linux): /opt/BantengJson/chimera/data
# Development: ./data
DATA_DIR=./data

# Rahasia sesi (minimal 32 karakter acak)
SESSION_SECRET=chimera_super_secret_session_key_change_in_production_32chars!

# Batas upload file tunggal dalam bytes (default 20 GB)
# 20 * 1024 * 1024 * 1024 = 21474836480
MAX_UPLOAD_BYTES=21474836480

# Ukuran potongan upload chunked/resumable dalam bytes (default 8 MB)
UPLOAD_CHUNK_BYTES=8388608

# Kuota default per user dalam bytes (default 100 GB)
# 100 * 1024 * 1024 * 1024 = 107374182400
DEFAULT_QUOTA_BYTES=107374182400

# URL publik untuk tautan berbagi (public shares)
PUBLIC_URL=http://localhost:5100

# Akun Admin default (dibuat saat inisialisasi jika belum ada)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=adminpassword123
INITIAL_ADMIN_NAME="Administrator"

